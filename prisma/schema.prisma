// Wordle Game - Prisma Schema for MongoDB

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// ===== AUTHENTICATION =====

model User {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  image             String?
  showInLeaderboard Boolean   @default(true)
  // A guest is a name-only identity created by the Credentials provider —
  // "Entrar sem conta" (see src/lib/auth.ts) — for someone without (or
  // unable to use) a Google account, e.g. a child whose account is under
  // Family Link and can't complete Google sign-in on their own. Guests
  // have no email/password and can't sign back into the SAME identity
  // later; each guest login creates a fresh row. `showInLeaderboard` is
  // force-set to false at creation and updateLeaderboardVisibility
  // refuses to flip it for a guest — CLAUDE.md's ranking-privacy rules
  // apply the same way here: a guest never appears in or is exposed
  // through the global ranking.
  isGuest           Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  accounts              Account[]
  sessions              Session[]
  roomsCreated          Room[]           @relation("RoomHost")
  roomParticipations    RoomParticipant[]
  submittedWords        SubmittedWord[]
  matchScores           MatchScore[]
  statistics            UserStatistics?
  roundAttempts         RoundAttempt[]
  roundHints            RoundHint[]
  singlePlayerGames     SinglePlayerGame[]
  singlePlayerStatistics SinglePlayerStatistics?

  @@index([showInLeaderboard])
}

model Account {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  userId             String  @db.ObjectId
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.String
  access_token       String? @db.String
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.String
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===== DICTIONARY/WORDS =====

model Word {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  word              String  @unique
  normalizedWord    String  @unique
  length            Int
  isNegative        Boolean @default(false)
  category          String?
  origin            String?
  icfScore          Float?
  isValid           Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  submittedWords SubmittedWord[]
  roundAnswers   Round[]         @relation("RoundAnswer")
  singlePlayerAnswers SinglePlayerGame[] @relation("SinglePlayerAnswer")

  @@index([length])
  @@index([isNegative])
  @@index([isValid])
  @@index([length, isValid])
}

// ===== GAME ROOMS & MULTIPLAYER =====

model Room {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  // Short, human-typeable public identifier (e.g. "7K3PQR") used in the
  // shareable URL and shown to players in the lobby, instead of the raw
  // ObjectId above — that's a 24-character hex string with no vowels or
  // separators, effectively impossible to read aloud, memorize, or type
  // correctly. Every FK below (`RoomParticipant.roomId`, `Game.roomId`,
  // `SubmittedWord.roomId`) still stores the real `id`, never `code` — the
  // code only exists as an alternate lookup key on this model.
  code              String             @unique
  hostId            String             @db.ObjectId
  wordLength        Int                // 4, 5, or 6
  status            RoomStatus         @default(LOBBY) // LOBBY, IN_PROGRESS, FINISHED
  maxPlayers        Int                @default(10)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  gameStartedAt     DateTime?
  gameEndedAt       DateTime?
  // The room's currently-relevant Game, if any — set when a match starts
  // (startGameInternal) and cleared when the host resets the room back to
  // LOBBY for another round without making everyone re-share the code
  // (playAgain). A room can rack up many Games across its lifetime this
  // way, so `games` below (its full history) can't double as "the current
  // one" the way a to-one relation used to — every FINISHED Game stays in
  // that list forever. Plain scalar rather than a formal relation since
  // every caller just needs the id (to link to `/game/[id]` or to check
  // whether it's finished), never a populated Game object.
  currentGameId     String?            @db.ObjectId

  // Relations
  host             User              @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  participants     RoomParticipant[]
  submittedWords   SubmittedWord[]
  games            Game[]

  @@index([status])
  @@index([hostId])
  @@index([createdAt])
}

enum RoomStatus {
  LOBBY
  IN_PROGRESS
  FINISHED
}

model RoomParticipant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId    String   @db.ObjectId
  userId    String   @db.ObjectId
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  status    ParticipantStatus @default(ACTIVE)

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  // Backs "does this user already have an active room?" (createRoom,
  // joinRoom, getActiveRoomForUser) — a per-user scan filtered by status,
  // instead of by roomId.
  @@index([userId, status])
}

enum ParticipantStatus {
  ACTIVE
  LEFT
  KICKED
}

model SubmittedWord {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId    String   @db.ObjectId
  userId    String   @db.ObjectId
  wordId    String   @db.ObjectId
  wordText  String   // Store the word text for reference
  submittedAt DateTime @default(now())

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id])

  @@unique([roomId, userId]) // Each player can submit only one word per room
  @@index([roomId])
  @@index([userId])
  @@index([wordId])
}

// ===== GAME MECHANICS =====

model Game {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  // Not unique: a room can play more than one match across its lifetime
  // (see Room.currentGameId and playAgain in room-actions.ts) — every
  // match still gets its own Game document, kept around as history after
  // it finishes, rather than being reused or overwritten in place.
  roomId        String   @db.ObjectId
  status        GameStatus @default(ACTIVE)
  totalRounds   Int      // Number of rounds = number of players
  currentRound  Int      @default(1)
  createdAt     DateTime @default(now())
  endedAt       DateTime?

  // Relations
  room   Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  rounds Round[]

  @@index([roomId])
  @@index([status])
}

enum GameStatus {
  ACTIVE
  FINISHED
}

model Round {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  gameId        String   @db.ObjectId
  roundNumber   Int
  answerWordId  String   @db.ObjectId
  answerWord    String   // For reference
  wordOwnerId   String   @db.ObjectId // User who submitted this word
  status        RoundStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  endedAt       DateTime?

  // Relations
  game     Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  answerWordRef Word  @relation("RoundAnswer", fields: [answerWordId], references: [id])
  attempts RoundAttempt[]
  hints    RoundHint[]

  @@unique([gameId, roundNumber])
  @@index([gameId])
  @@index([answerWordId])
  @@index([wordOwnerId])
}

enum RoundStatus {
  ACTIVE
  FINISHED
}

model RoundAttempt {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  roundId     String   @db.ObjectId
  userId      String   @db.ObjectId
  attemptText String
  attemptNumber Int
  result      AttemptResult[] // Array of letter results
  isCorrect   Boolean
  createdAt   DateTime @default(now())

  // Relations
  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@index([userId])
}

// A free-text hint the round's spectator (the word's owner — see
// Round.wordOwnerId) can send to the players actively guessing. Kept as
// its own model rather than a plain string array embedded on Round so each
// hint carries its own timestamp and author, and so it participates in the
// same "server is authoritative" pattern as RoundAttempt — sendRoundHint
// verifies the caller actually IS the round's spectator before writing one.
model RoundHint {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  roundId   String   @db.ObjectId
  authorId  String   @db.ObjectId
  text      String
  createdAt DateTime @default(now())

  // Relations
  round  Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([roundId])
}

type AttemptResult {
  letter String
  status String // CORRECT, PRESENT, ABSENT
}

// ===== SCORING =====

model MatchScore {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  gameId   String   @db.ObjectId
  userId   String   @db.ObjectId
  finalScore Int    @default(0)
  placement  Int?    // 1st, 2nd, 3rd, etc
  roundScores RoundScoreEntry[] // Score per round

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([gameId])
  @@index([userId])
}

type RoundScoreEntry {
  roundNumber Int
  score       Int
  attemptsUsed Int
}

// ===== USER STATISTICS =====

model UserStatistics {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                String   @unique @db.ObjectId
  totalGamesPlayed      Int      @default(0)
  totalWins             Int      @default(0)
  totalPoints           Int      @default(0)
  averageScore          Float    @default(0)
  bestScore             Int      @default(0)
  lastGamePlayedAt      DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalPoints])
  @@index([averageScore])
}

// ===== SINGLE PLAYER MODE =====
//
// Deliberately separate from Room/Game/Round: a single-player game has no
// spectator, no other participants, and no lobby — reusing the multiplayer
// models would mean every query and every security check (e.g. "am I the
// round's spectator?") would need to special-case a room of one. Its
// statistics are also kept in their own model (SinglePlayerStatistics)
// rather than folded into UserStatistics/the global ranking, since a solo
// practice game and a placement in a competitive multiplayer match aren't
// the same kind of "win" — mixing them would distort what the leaderboard
// is supposed to represent.

model SinglePlayerGame {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  wordLength    Int      // 4, 5, or 6
  // The secret word, resolved once at creation and never sent to the
  // client until the game is no longer ACTIVE — same rule as Round.
  answerWordId  String   @db.ObjectId
  answerWord    String
  status        SinglePlayerStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  endedAt       DateTime?

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answerWordRef Word     @relation("SinglePlayerAnswer", fields: [answerWordId], references: [id])
  attempts      SinglePlayerAttempt[]

  @@index([userId])
  @@index([status])
  @@index([userId, status])
}

enum SinglePlayerStatus {
  ACTIVE
  WON
  LOST
}

model SinglePlayerAttempt {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  gameId        String   @db.ObjectId
  attemptText   String
  attemptNumber Int
  result        AttemptResult[]
  isCorrect     Boolean
  createdAt     DateTime @default(now())

  // Relations
  game SinglePlayerGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model SinglePlayerStatistics {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String    @unique @db.ObjectId
  totalGamesPlayed  Int       @default(0)
  totalWins         Int       @default(0)
  currentStreak     Int       @default(0)
  bestStreak        Int       @default(0)
  // Count of wins by attempts used (index 0 = won in 1 attempt, ... index
  // 5 = won in 6 attempts) — the classic Wordle "guess distribution".
  guessDistribution Int[]     @default([0, 0, 0, 0, 0, 0])
  lastPlayedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===== UTILITY MODELS =====

model VerificationToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
